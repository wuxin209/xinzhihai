        "name": "黄焖鸡",
        "ingredients": [
          "鸡腿肉 400g",
          "青椒 1个",
          "香菇 5朵",
          "土豆 1个",
          "姜片 3片",
          "葱段 少许",
          "干辣椒 3个",
          "生抽 2勺",
          "老抽 1勺",
          "蚝油 1勺",
          "黄豆酱 1勺"
        ],
        "steps": [
