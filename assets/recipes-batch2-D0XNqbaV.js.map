    [
      {
        "id": "b2-1",
        "name": "小米粥",
        "ingredients": [
          "小米 50g",
          "大米 30g",
          "枸杞 少许",
          "白糖 可选"
        ],
        "steps": [
          "小米和大米淘洗干净。",
          "锅中加足量水，大火煮开。",
          "转小火慢熬30分钟，偶尔搅拌防止粘锅。",
          "出锅前撒枸杞即可，可加白糖调味。"
        ],
        "difficulty": "简单",
        "duration": "35分钟",
        "mealType": "早餐",
        "emoji": "🥣",
        "calories": 180
      },
      {
        "id": "b2-3",
        "name": "手抓饼",
        "ingredients": [
          "手抓饼 1张",
          "鸡蛋 1个",
          "生菜 1片",
          "番茄酱 适量",
          "火腿肠 1根（可选）"
        ],
        "steps": [
          "平底锅不放油，放手抓饼小火煎。",
          "一面金黄后翻面，打入鸡蛋摊开。",
          "鸡蛋凝固后再翻面。",
          "加生菜、火腿肠、番茄酱。",
          "卷起来即可食用。"
        ],
        "difficulty": "简单",
        "duration": "8分钟",
        "mealType": "早餐",
        "emoji": "🫓",
        "calories": 400
      },
      {
        "id": "b2-6",
        "name": "白粥配咸蛋",
        "ingredients": [
          "大米 80g",
          "咸鸭蛋 1个",
          "榨菜 少许",
          "香油 几滴"
        ],
        "steps": [
          "大米淘洗干净，加足量水。",
          "大火煮开转小火熬40分钟至浓稠。",
          "咸鸭蛋对半切。",
          "粥盛出，配咸鸭蛋和榨菜吃。"
        ],
        "difficulty": "简单",
        "duration": "45分钟",
        "mealType": "早餐",
        "emoji": "🍚",
        "calories": 200
      },
      {
        "id": "l2-1",
        "name": "啤酒鸭",
        "ingredients": [
          "鸭肉 500g",
          "啤酒 1罐",
          "姜片 5片",
          "葱段 少许",
          "蒜片 少许",
          "八角 2个",
          "干辣椒 5个",
          "生抽 2勺",
          "老抽 1勺",
          "冰糖 少许"
        ],
        "steps": [
          "鸭肉切块，冷水下锅焯水捞出。",
          "热锅下油，爆香姜蒜、八角、干辣椒。",
          "下鸭肉翻炒至表面微黄。",
          "加生抽、老抽、冰糖翻炒上色。",
          "倒入整罐啤酒，加葱段，大火煮开转小火炖40分钟。",
          "大火收汁至浓稠即可。"
        ],
        "difficulty": "中等",
        "duration": "55分钟",
        "mealType": "午餐",
        "emoji": "🦆",
        "calories": 460,
        "lunchSet": 1
      },
      {
        "id": "l2-2",
        "name": "干煸四季豆",
        "ingredients": [
          "四季豆 300g",
          "猪肉末 80g",
          "蒜末 少许",
          "干辣椒 5个",
          "花椒 少许",
          "生抽 1勺",
          "盐 适量"
        ],
        "steps": [
          "四季豆掰成长段，擦干水分。",
          "热锅下油，下四季豆炸至表皮起皱捞出（或小火干煸）。",
          "锅留底油，炒香肉末盛出。",
          "爆香蒜末、干辣椒、花椒。",
          "下四季豆和肉末翻炒。",
          "加生抽和盐调味，翻炒均匀出锅。"
        ],
        "difficulty": "中等",
        "duration": "20分钟",
        "mealType": "午餐",
        "emoji": "🫛",
        "calories": 220,
        "lunchSet": 1
      },
      {
        "id": "l2-3",
        "name": "番茄炒蛋",
        "ingredients": [
          "西红柿 2个",
          "鸡蛋 3个",
          "葱花 少许",
          "盐 适量",
          "白糖 半勺"
        ],
        "steps": [
          "西红柿切块，鸡蛋打散加少许盐。",
          "热锅下油，倒入蛋液快速划散盛出。",
          "锅留底油，下西红柿翻炒出汁。",
          "加少许盐和白糖调味。",
          "倒入炒好的鸡蛋，翻匀撒葱花出锅。"
        ],
        "difficulty": "简单",
        "duration": "10分钟",
        "mealType": "午餐",
        "emoji": "🍅",
        "calories": 200,
        "lunchSet": 1
      },
      {
        "id": "l2-4",
        "name": "冬瓜排骨汤",
        "ingredients": [
          "排骨 300g",
          "冬瓜 200g",
          "薏米 少许",
          "姜片 3片",
          "盐 适量",
          "料酒 1勺"
        ],
        "steps": [
          "排骨冷水下锅加料酒焯水捞出。",
          "薏米提前泡1小时。",
